          "refId": "A",
          "expr": "{service=\"app\", event=~\"LOGIN_FAILED|LOGIN_SUCCESS|SUSPICIOUS_INPUT|ACCESS_DENIED|CSRF_REJECTED\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ]
    },
