# =============================================================
# FILE MẪU BIẾN MÔI TRƯỜNG
#   - Chạy:  bash scripts/setup.sh   -> tự tạo file .env với mật khẩu ngẫu nhiên mạnh
#   - Hoặc:  cp .env.example .env  rồi tự điền mật khẩu
#   - File .env đã nằm trong .gitignore -> KHÔNG đẩy lên GitHub
# =============================================================

# Các file compose được dùng khi gõ "docker compose up -d"
#   Commit 1: chỉ docker-compose.yml
#   Commit 2: thêm docker-compose.monitoring.yml
#   Commit 3: thêm docker-compose.logging.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml:docker-compose.logging.yml

TZ=Asia/Ho_Chi_Minh

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_EXPORTER_PASSWORD=CHANGE_ME

# ---- Ứng dụng Forum ----
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- Lớp bảo vệ Basic Auth trước phpMyAdmin (Nginx) ----
PMA_BASIC_AUTH_USER=dbadmin
PMA_BASIC_AUTH_PASSWORD=CHANGE_ME
