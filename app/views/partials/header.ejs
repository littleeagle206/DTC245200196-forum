<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Diễn đàn Cộng đồng</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">💬 Diễn đàn <span>Cộng đồng</span></a>
    <form class="search" action="/search" method="get">
      <input name="q" placeholder="Tìm bài viết..." maxlength="100" aria-label="Tìm kiếm">
    </form>
    <nav class="nav">
      <% if (user) { %>
        <a class="btn btn-primary" href="/new">+ Viết bài</a>
        <span class="who"><%= user.username %><% if (user.role === 'admin') { %> <em class="badge">admin</em><% } %></span>
        <form action="/logout" method="post" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-ghost">Đăng xuất</button>
        </form>
      <% } else { %>
        <a class="btn btn-ghost" href="/login">Đăng nhập</a>
        <a class="btn btn-primary" href="/register">Đăng ký</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">
<% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
